    "ratesQuotaMessage": {
      "comment": "Message of the monthly API limit card.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can load more days once the limit renews. Loaded days are still available."
