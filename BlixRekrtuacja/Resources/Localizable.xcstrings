    "ratesNoResultsMessage": {
      "comment": "Message shown when no currency matches the search; the argument is the typed text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing matches “%@”. Type a code or a name."
