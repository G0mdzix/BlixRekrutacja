    "ratesBaseInfo": {
      "comment": "Line under the title; the argument is the base currency code, e.g. EUR.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How much 1 %@ is in other currencies"
