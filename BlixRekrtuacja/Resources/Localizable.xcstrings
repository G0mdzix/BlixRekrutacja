    "ratesFirstLoadFailedTitle": {
      "comment": "Title of the screen shown when no rates could be loaded.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't load the rates"
