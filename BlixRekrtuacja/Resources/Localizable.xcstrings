    "ratesSelectCurrencyMessage": {
      "comment": "Landscape detail pane message when no rate is selected.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a rate in the list to see its exact value, date and change since the previous day."
