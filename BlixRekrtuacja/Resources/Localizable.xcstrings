{
  "sourceLanguage": "en",
  "strings": {
    "appearanceDark": {
      "comment": "Appearance option: always dark.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dark"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciemny"
          }
        }
      }
    },
    "appearanceLight": {
      "comment": "Appearance option: always light.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Light"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jasny"
          }
        }
      }
    },
    "appearanceSystem": {
      "comment": "Appearance option: follow the system setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemowy"
          }
        }
      }
    },
    "commonRetry": {
      "comment": "Button that retries a failed action.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spróbuj ponownie"
          }
        }
      }
    },
    "errorGenericMessage": {
      "comment": "Inline error message (empty state or footer card) for an unexpected error.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please try again in a moment."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spróbuj ponownie za chwilę."
          }
        }
      }
    },
    "errorInvalidAPIKeyMessage": {
      "comment": "Inline error message (empty state or footer card): the rate service rejected the access key (HTTP 401/403, Fixer codes 101 and 102). Developers fix it in Config/Secrets.xcconfig.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rate service rejected the app's access key."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwis kursów odrzucił klucz dostępu aplikacji."
          }
        }
      }
    },
    "errorMissingAPIKeyMessage": {
      "comment": "Error message: the app was built without a rates API key.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app has no API key for rates. Add it to Config/Secrets.xcconfig and build the app again."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja nie ma klucza API do kursów. Dodaj go w pliku Config/Secrets.xcconfig i zbuduj aplikację ponownie."
          }
        }
      }
    },
    "errorOfflineMessage": {
      "comment": "Inline error message (empty state or footer card): no internet connection.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No internet connection. Check your connection and try again."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak połączenia z internetem. Sprawdź połączenie i spróbuj ponownie."
          }
        }
      }
    },
    "errorQuotaExceededMessage": {
      "comment": "Inline error message (empty state or footer card): the monthly limit of rate requests is used up (Fixer code 104).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The monthly limit of rate requests is used up. Loaded days are still available."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykorzystano miesięczny limit zapytań o kursy. Wczytane dni są nadal dostępne."
          }
        }
      }
    },
    "errorServerMessage": {
      "comment": "Inline error message (empty state or footer card): HTTP 5xx, host unreachable, unreadable response, or an unrecognised Fixer error code.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong on our side. Try again later."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wystąpił problem po stronie serwera. Spróbuj ponownie później."
          }
        }
      }
    },
    "errorTimeoutMessage": {
      "comment": "Inline error message (empty state or footer card): the server took too long to respond.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server is taking too long to respond. Try again in a moment."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer zbyt długo nie odpowiada. Spróbuj ponownie za chwilę."
          }
        }
      }
    },
    "errorTooManyRequestsMessage": {
      "comment": "Inline error message (empty state or footer card): HTTP 429, rate limit exceeded.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many attempts. Wait a moment and try again."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbyt wiele prób. Odczekaj chwilę i spróbuj ponownie."
          }
        }
      }
    },
    "languageEnglish": {
      "comment": "Language option: English, always written in English.",
